# Opcional. Si no están, el bar funciona igual y no llama a la central.
# NUBE_URL es el dominio de Vercel, sin barra final.
NUBE_URL=https://tu-proyecto.vercel.app
NUBE_TOKEN=cambia-esta-clave

# En Vercel, la misma NUBE_TOKEN.
# Para que el estado no se borre, una de estas dos:
# DATABASE_URL=postgres://...
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...

# Acceso privado al panel superadmin (no reutilices estas cadenas de ejemplo).
# Genera SUPERADMIN_SESSION_SECRET con node y randomBytes(48).
SUPERADMIN_USER=tu-usuario-privado
SUPERADMIN_PASSWORD=cambia-por-una-frase-de-mas-de-16-caracteres
SUPERADMIN_SESSION_SECRET=pega-aqui-un-secreto-aleatorio-de-al-menos-32-caracteres

# URL HTTPS de una instancia separada del raspberry-backend, con base de datos propia.
DEMO_RESTAURANT_URL=https://tu-backend-de-pruebas.example.com

# Variables privadas de la instancia que alojará el restaurante de pruebas.
# Úsalas solo al inicializar una base de datos nueva.
RESTAURANTE_ID=restaurante-pruebas
DEMO_RESTAURANT_NAME=Restaurante de pruebas
DEMO_ADMIN_EMAIL=admin-pruebas@example.invalid
DEMO_ADMIN_PASSWORD=cambia-por-otra-frase-privada-de-mas-de-16-caracteres
DEMO_ADMIN_PIN=123456
DEMO_WAITER_NAME=Camarero de pruebas
DEMO_WAITER_PIN=654321
