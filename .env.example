# Opcional. Si no están, el bar funciona igual y no llama a la central.
# NUBE_URL es el dominio de Vercel, sin barra final.
NUBE_URL=https://tu-proyecto.vercel.app
NUBE_TOKEN=cambia-esta-clave

# En Vercel, la misma NUBE_TOKEN.
