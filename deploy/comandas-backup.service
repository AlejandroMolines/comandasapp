[Unit]
Description=Comandas — copia de seguridad de la base de datos

[Service]
Type=oneshot
User=comandas
Group=comandas
WorkingDirectory=/opt/comandas/apps/raspberry-backend
Environment=DB_PATH=/var/lib/comandas/local.sqlite
Environment=DESTINO_BACKUP=/var/backups/comandas
ExecStart=/usr/bin/node scripts/mantenimiento.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/comandas /var/backups/comandas
UMask=0027
